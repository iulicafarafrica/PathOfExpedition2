{
  "name": "path-of-expedition",
  "version": "1.1.13",
  "private": true,
  "description": "PoE2 Expedition Runeshape price checker",
  "main": "main.js",
  "author": "iulian.icb",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.iulianicb.pathofexpedition",
    "productName": "Path of Expedition",
    "files": [
      "main.js",
      "preload.js",
      "rows.js",
      "planner.js",
      "ocr.ps1",
      "renderer/**/*",
      "data/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["portable", "nsis"]
    },
    "portable": {
      "unpackDirName": "PathOfExpedition"
    },
    "electronLanguages": ["en-US"],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
