{
  "name": "path-of-expedition",
  "version": "1.1.22",
  "private": true,
  "description": "PoE2 Expedition Runeshape price checker",
  "main": "main.js",
  "author": "iulian.icb",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "preflight": "node scripts/preflight.js",
    "preflight:release": "node scripts/preflight.js --release",
    "predist": "node scripts/preflight.js",
    "dist": "electron-builder",
    "build-names": "node tools/build-names.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.iulianicb.pathofexpedition",
    "productName": "Path of Expedition",
    "files": [
      "main.js",
      "preload.js",
      "rows.js",
      "names.js",
      "planner.js",
      "lib/**/*",
      "renderer/**/*",
      "data/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "unpackDirName": "PathOfExpedition"
    },
    "electronLanguages": [
      "en-US"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
